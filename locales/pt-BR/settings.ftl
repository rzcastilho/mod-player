setting-value-dbfs = { $value } dBFS
setting-value-percent = { $value }%
setting-value-ms = { $value } ms
setting-range-dbfs = { $min } a { $max } dBFS
setting-range-percent = { $min } a { $max }%
setting-range-ms = { $min } a { $max } ms

settings-reset = Redefinir
settings-reset-a11y = Redefinir { $field } para o padrão

